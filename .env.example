# ── LLM Provider ──
LLM_PROVIDER=gemini        # Options: gemini, ollama, openai
GOOGLE_API_KEY=your-google-api-key

# ── Paper Source APIs ──
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-key    # optional
CORE_API_KEY=your-core-api-key                        # optional

# ── Neo4j (optional) ──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── Model Settings ──
LLM_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=models/embedding-001

# ── Ollama Settings (if provider is ollama) ──
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b

# ── OpenAI Settings (if provider is openai) ──
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o

# ── ChromaDB ──
CHROMA_PERSIST_DIR=data/chroma_db

# ── Processing ──
CHUNK_SIZE=600
CHUNK_OVERLAP=50

# ── API ──
API_HOST=127.0.0.1
API_PORT=8000

# ── Logging ──
LOG_LEVEL=INFO
